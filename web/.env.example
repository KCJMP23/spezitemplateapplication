# Firebase Configuration
# For testing without Firebase, set VITE_DISABLE_FIREBASE=true below
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Firebase Emulator (Development) - Set to false to disable emulator
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Disable Firebase entirely for offline testing (set to true)
VITE_DISABLE_FIREBASE=false

# Application Configuration
VITE_APP_NAME=INTELLIC Health
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_SKIP_ONBOARDING=false
VITE_SHOW_ONBOARDING=true
VITE_ENABLE_TEST_ACCOUNT=true
VITE_ENABLE_ANALYTICS=false

# User Role Configuration
VITE_DEFAULT_USER_ROLE=patient
VITE_ENABLE_MULTI_ROLE=true

# FHIR Configuration
VITE_FHIR_VERSION=4.0.1
VITE_FHIR_SERVER_URL=

# Epic MyChart / SMART on FHIR
VITE_EPIC_CLIENT_ID=
VITE_EPIC_REDIRECT_URI=
VITE_EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# Withings API
VITE_WITHINGS_CLIENT_ID=
VITE_WITHINGS_CLIENT_SECRET=
VITE_WITHINGS_REDIRECT_URI=
VITE_WITHINGS_API_URL=https://wbsapi.withings.net

# Healthcare Compliance
VITE_HIPAA_MODE=true
VITE_AUDIT_LOGGING=true
VITE_DATA_RETENTION_DAYS=2555

# PWA Configuration
VITE_PWA_OFFLINE_MODE=true
VITE_PWA_BACKGROUND_SYNC=true

# Device Integration
VITE_ENABLE_HEALTHKIT=true
VITE_ENABLE_WITHINGS=true
VITE_ENABLE_EPIC_MYCHART=true
